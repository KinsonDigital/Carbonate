<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Release NonDirPushReactable" />
    <BuildType Name="Release OneWayPullReactable" />
    <BuildType Name="Release OneWayPushReactable" />
    <BuildType Name="Release TwoWayPushPullReactable" />
    <Platform Name="arm64" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/Samples/">
    <Project Path="Samples/Samples/Samples.csproj">
      <BuildType Solution="Release NonDirPushReactable|*" Project="Release" />
      <BuildType Solution="Release OneWayPullReactable|*" Project="Release" />
      <BuildType Solution="Release OneWayPushReactable|*" Project="Release" />
      <BuildType Solution="Release TwoWayPushPullReactable|*" Project="Release" />
      <Platform Solution="*|arm64" Project="arm64" />
      <Platform Solution="*|x64" Project="x64" />
    </Project>
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitignore" />
    <File Path="LICENSE.md" />
    <File Path="README.md" />
    <File Path="renovate.json" />
  </Folder>
  <Folder Name="/Solution Items/RunDebugConfigs/">
    <File Path=".run/CarbonatePerfTests.run.xml" />
    <File Path=".run/Samples.run.xml" />
  </Folder>
  <Folder Name="/Solution Items/Workflows/">
    <File Path=".github/workflows/add-new-item-to-project.yml" />
    <File Path=".github/workflows/build-status-check.yml" />
    <File Path=".github/workflows/prepare-release.yml" />
    <File Path=".github/workflows/release.yml" />
    <File Path=".github/workflows/sonar-scan-pr-status-check.yml" />
    <File Path=".github/workflows/sync-bot.yml" />
    <File Path=".github/workflows/sync-pr-to-issue.yml" />
    <File Path=".github/workflows/sync-status-check.yml" />
    <File Path=".github/workflows/test-status-check.yml" />
  </Folder>
  <Folder Name="/Testing/">
    <File Path="Testing/.editorconfig" />
    <Project Path="Testing/CarbonateIntegrationTests/CarbonateIntegrationTests.csproj">
      <BuildType Solution="Release NonDirPushReactable|*" Project="Release" />
      <BuildType Solution="Release OneWayPullReactable|*" Project="Release" />
      <BuildType Solution="Release OneWayPushReactable|*" Project="Release" />
      <BuildType Solution="Release TwoWayPushPullReactable|*" Project="Release" />
      <Platform Solution="*|arm64" Project="arm64" />
      <Platform Solution="*|x64" Project="x64" />
    </Project>
    <Project Path="Testing/CarbonatePerfTests/CarbonatePerfTests.csproj">
      <Platform Solution="*|arm64" Project="arm64" />
      <Platform Solution="*|x64" Project="x64" />
    </Project>
    <Project Path="Testing/CarbonateTests/CarbonateTests.csproj">
      <BuildType Solution="Release NonDirPushReactable|*" Project="Release" />
      <BuildType Solution="Release OneWayPullReactable|*" Project="Release" />
      <BuildType Solution="Release OneWayPushReactable|*" Project="Release" />
      <BuildType Solution="Release TwoWayPushPullReactable|*" Project="Release" />
      <Platform Solution="*|arm64" Project="arm64" />
      <Platform Solution="*|x64" Project="x64" />
    </Project>
  </Folder>
  <Project Path="Carbonate/Carbonate.csproj">
    <BuildType Solution="Release NonDirPushReactable|*" Project="Release" />
    <BuildType Solution="Release OneWayPullReactable|*" Project="Release" />
    <BuildType Solution="Release OneWayPushReactable|*" Project="Release" />
    <BuildType Solution="Release TwoWayPushPullReactable|*" Project="Release" />
    <Platform Solution="*|arm64" Project="arm64" />
    <Platform Solution="*|x64" Project="x64" />
  </Project>
</Solution>
